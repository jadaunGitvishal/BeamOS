# ScreenTinker server configuration — process environment variables.
#
# NOTE: the app reads these from the *process environment* (your systemd unit's
# Environment=/EnvironmentFile=, your container runtime, or your shell). It does
# NOT auto-load this file. Copy the values you need into your process manager.
# This file exists only to document the available options.

# --- Self-hosting ---
# Set to "true" on your own instance. When true, the hosted signup emails
# (welcome to the user + admin notification) are disabled, so a self-hosted
# instance never emits mail from a domain that isn't yours.
SELF_HOSTED=true

# Hide the Subscription/billing UI (nav item + pricing cards) and bounce #/billing to
# the dashboard. Opt-in; default off (billing shown). For instances that bill customers
# externally and don't sell plans through the app. UI-only — does not change SELF_HOSTED
# or disable any /api/subscription endpoints.
HIDE_BILLING=true

# Close public self-service registration — for instances where all accounts are
# provisioned by your team (admin "Add user" / invites). When true, the public
# signup route is blocked (OAuth auto-signup with it) AND the login page hides
# its "Create account" button so the UI matches the backend. First-user setup on
# an empty DB is still allowed so a fresh install can be initialized.
# DISABLE_REGISTRATION=true

# Redirect "/" to the app (/app) instead of serving the marketing landing page.
# For internal-only deployments that don't want the public homepage shown.
# DISABLE_HOMEPAGE=true

# Where new-signup admin notifications are sent. Leave UNSET to disable admin
# notifications entirely — the user's welcome email is unaffected. Self-hosters
# who want to be notified of signups set this to their own address.
# ADMIN_NOTIFY_EMAIL=you@example.com

# Marks THIS deployment as the hosted (screentinker.com) instance. Gates the
# daily activation-nudge sweep (the T+3 "haven't paired a screen yet?" email).
# Leave UNSET on self-hosted instances so a daily bulk sweep never emails your
# user base with our onboarding mail. Only the hosted instance sets this true.
# HOSTED_INSTANCE=true

# Absolute base URL of this instance, used for links inside outbound email (e.g.
# the device page an SLA breach alert points to). Unset -> a root-relative path
# ("/dashboard#/device/...") is used instead. No trailing slash needed.
# PUBLIC_BASE_URL=https://signage.example.com

# --- Outbound email (Microsoft Graph, client-credentials flow) ---
# Required for ANY email (welcome, offline alerts, admin notify) to actually
# send. Leave blank and the app logs "[EMAIL] not configured" instead of sending.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER_EMAIL=signage@example.com
# GRAPH_SENDER_NAME=ScreenTinker
# Dev safety net: comma-separated allow-list of recipients. When set, mail to
# any address NOT in the list is suppressed (logged, not sent). Leave UNSET in
# production. Useful locally so test signups can't email real users.
# GRAPH_DEV_RESTRICT_TO=me@example.com

# --- Microsoft Entra ID: SSO login (Ref 5) and API Service Principals (Ref 9) ---
# These are TWO INDEPENDENT features with DELIBERATELY SEPARATE tenant settings.
# SSO_TENANT_ID never falls back to ENTRA_TENANT_ID's value. If one variable drove
# both, a deployment that set ENTRA_TENANT_ID only to let an ERP/daemon call the API
# would, on upgrade, have its HUMAN "Sign in with Microsoft" silently switched to
# single-tenant id_token-only mode - locking out personal / other-tenant Microsoft
# accounts and any browser still running the old login page (access_token only).
# Set each one only when you intend to turn that feature on. They MAY hold the same
# tenant GUID.
#
# Login app registration (MSAL "Sign in with Microsoft"). Unset = button hidden.
# MICROSOFT_CLIENT_ID=
# MSAL authority when SSO_TENANT_ID is unset (default "common" = any account).
# MICROSOFT_TENANT_ID=common
# Ref 5: restrict human Microsoft login to ONE Entra tenant. Set -> the server
# requires and validates an OIDC id_token (issuer/tid = this tenant, aud =
# MICROSOFT_CLIENT_ID). Unset -> the original access_token + Graph /me login,
# unchanged. See docs/sso-scim-integration.md.
# SSO_TENANT_ID=
# Ref 5: additionally require MFA (id_token `amr` must contain "mfa"; the app
# registration must request `amr` as an ID-token optional claim). Only applies
# when SSO_TENANT_ID is set.
# ENTRA_REQUIRE_MFA=true
# Ref 9: machine-to-machine API auth for Entra Service Principals. Both unset =
# disabled. Has NO effect on human login. See docs/entra-auth.md.
# ENTRA_TENANT_ID=
# ENTRA_API_CLIENT_ID=
# Ref 8: organization role given to users created by SCIM provisioning
# (/scim/v2). One of org_owner / org_admin / field_technician.
# SCIM_DEFAULT_ORG_ROLE=field_technician

# --- Data-platform export (Snowflake / Databricks / dbt / Atlan) ---
# Ref 28. Periodically lands device, uptime, SLA, proof-of-play, ticket and SIM
# inventory data as gzipped newline-delimited JSON in an S3-compatible bucket,
# one object per workspace per data domain per sweep. See
# docs/data-platform-integration.md for how each platform reads it. OFF unless
# set to exactly "true" — most self-hosted instances have no data platform to feed.
# DATA_PLATFORM_EXPORT_ENABLED=true
# DATA_PLATFORM_S3_BUCKET=my-data-lake
# Key prefix inside the bucket (default "beamos/").
# DATA_PLATFORM_S3_PREFIX=beamos/
# DATA_PLATFORM_S3_REGION=us-east-1
# Only for non-AWS stores (MinIO, Cloudflare R2, ...). Leave UNSET for AWS S3.
# DATA_PLATFORM_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Leave both UNSET on AWS to use the SDK's default credential chain (e.g. an
# instance role) instead of a static key pair.
# DATA_PLATFORM_S3_ACCESS_KEY_ID=
# DATA_PLATFORM_S3_SECRET_ACCESS_KEY=
# Minutes between sweeps (default 60).
# DATA_PLATFORM_EXPORT_INTERVAL_MIN=60
