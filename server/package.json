{
  "name": "BeamOS",
  "version": "1.9.2-patch3",
  "description": "BeamOS - Digital Signage Management Server",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "build": "node build.js",
    "build:dashboard": "node scripts/link-dashboard-deps.js && vite build --config vite.dashboard.config.js",
    "dev:dashboard": "node scripts/link-dashboard-deps.js && vite --config vite.dashboard.config.js",
    "test": "node --test"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.11.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.2",
    "stripe": "^20.4.1",
    "unzipper": "^0.12.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "better-sqlite3": "^9.4.3",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "socket.io-client": "^4.8.3",
    "vite": "^5.4.0"
  }
}
